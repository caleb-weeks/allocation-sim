[Unit]
Description=Allocation simulator API (Express + Socket.IO)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=allocation
WorkingDirectory=/srv/allocation-sim/apps/api
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --import ./dist/instrument.js dist/server.js
Restart=on-failure
RestartSec=3
# Give in-flight requests and socket pushes time to finish (server.ts handles SIGTERM).
TimeoutStopSec=15

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/allocation-sim
MemoryMax=600M

[Install]
WantedBy=multi-user.target
