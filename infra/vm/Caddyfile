# Caddy terminates TLS (automatic Let's Encrypt) and proxies to the API.
# The web app is on Vercel at allocation.calebweeks.com. DNS: an A record for api.calebweeks.com → this VM's IP.
api.calebweeks.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:4000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
