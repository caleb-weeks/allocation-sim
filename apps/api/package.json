{
  "name": "@allocation-sim/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @allocation-sim/engine build && prisma generate && tsc -p tsconfig.json",
    "start": "node --import ./dist/instrument.js dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "demo:reset": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@allocation-sim/engine": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "^11.7.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  },
  "exports": {
    "./protocol": "./src/protocol.ts"
  }
}
