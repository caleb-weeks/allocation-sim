# Local: postgresql://USER@localhost:5432/allocation_sim
# On the VM (unix socket, peer auth): postgresql://allocation@localhost/allocation_sim?host=/var/run/postgresql
DATABASE_URL=postgresql://USER@localhost:5432/allocation_sim
PORT=4000
# Comma-separated origins allowed to call the API with cookies (the web app).
# Production: https://allocation.calebweeks.com
WEB_ORIGINS=http://localhost:3000
# Leave empty (also in production): the cookie stays scoped to the API's host, and since the web app
# and API share a registrable domain (allocation. / api.calebweeks.com) it is still same-site.
# Only set it if the web app itself ever needs to read the cookie.
COOKIE_DOMAIN=
SENTRY_DSN=
