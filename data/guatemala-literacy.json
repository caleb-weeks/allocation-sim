{
  "id": "guatemala-literacy",
  "title": "Guatemala literacy programs, by department",
  "summary": "Youth and adult literacy programs in Guatemala's 22 departments, sized from CONALFA's 2023 projection of illiteracy by department and sex. Program costs are illustrative assumptions.",
  "valueUnit": "learners reached per $1,000 (need-weighted)",
  "sources": [
    {
      "name": "CONALFA — Proyección de población alfabeta y analfabeta de 15 años y más, 2023",
      "url": "https://www.conalfa.edu.gt/data/proyeccion2023.pdf"
    }
  ],
  "assumptions": {
    "cost_per_learner_usd": 100,
    "reach_fraction_per_round": 0.02,
    "hardest_to_reach_cost_multiple": 2.5,
    "note": "Illustrative program economics, not sourced estimates: about $100 per learner who completes a course, a single round can enrol at most 2% of a department's illiterate population, and the last learners reached cost 2.5x the first."
  },
